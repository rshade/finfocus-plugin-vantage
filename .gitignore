# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.so.*
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.out
*.cov
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# Dependency directories
vendor/

# Build output
bin/
dist/

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Wiremock artifacts (stub mappings are committed, but response files are not)
test/wiremock/__files/

# Temp files
*.tmp
*.bak
/finfocus-plugin-vantage
/bin/finfocus-plugin-vantage
COMMIT_MESSAGE.md
PR_MESSAGE.md
Github_Development_Prompt.md
Github_Development_Prompt_Grok.md
node_modules/
CodeRabbitPrompt.md
TODO.md

# Vale: ignore downloaded style packages, keep config/vocabularies
.vale/styles/*
!.vale/styles/config/
